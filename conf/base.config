/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    da-bar/wgpa Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_low_memory {
        memory = { 1.GB * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }

    // lastdb runs with one thread, as in v1.0.0. The index files made with more threads differ (.suf),
    // although the alignments did not change in our tests. Indexing is fast compared with lastal.
    withName: 'LAST_LASTDB' {
        cpus   = { 1 }
    }
    // The nf-core module runs lastal -P <cpus>. With more than one thread lastal writes the
    // alignments of the query sequences in a run-dependent order. The chaining and netting steps
    // depend on that order (chain IDs, ties between equal-scoring chains), so the chains, nets and
    // axt files change too. One thread keeps every output deterministic and identical to v1.0.0.
    // See docs/usage.md before raising it: the pipeline warns when it is more than 1 (conf/modules.config).
    // Memory: lastal maps the target index (about 4 bytes per target base) and needs working memory for the
    // query batch; the process_high label (72 GB) is more than a single-threaded lastal needs and does not
    // fit on a 64 GB workstation.
    withName: 'LAST_LASTAL' {
        cpus   = { 1 }
        memory = { 36.GB * task.attempt }
    }
    // maf-convert psl is single-threaded and streams its input
    withName: 'LAST_MAFCONVERT' {
        cpus   = { 1 }
        memory = { 6.GB * task.attempt }
    }
    // LASTZ runs one task per chunk of target sequences (--lastz_chunk_size); each task runs one single-threaded lastz
    // per (target sequence, query sequence), up to <cpus> at a time. The outputs are joined in a fixed order, so they
    // do not depend on the number of tasks or cpus (process_medium label).
    // Each lastz holds one target and one query sequence, so memory grows with the largest sequences, not the genome.
    // axtChain is single-threaded. It holds all the alignments of its input in memory: a whole pair needs the most
    // (the process_medium label's memory); a chaining tile (--chain_chunk_size, meta.chain_tile) much less.
    withName: 'UCSC_AXTCHAIN' {
        cpus   = { 1 }
        memory = { (meta.chain_tile ? 6.GB : 36.GB) * task.attempt }
    }
    // MUMmer4 nucmer (process_medium label) runs with <cpus> threads; its PSL is sorted, so the PSL and everything
    // made from it do not depend on the number of threads. nucmer keeps a suffix array of the whole target in
    // memory (roughly 10-20 bytes per target base): raise the memory for large target genomes.
}
