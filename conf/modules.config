/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.

    The selectors name the subworkflow ('.*:CHAIN_NET:UCSC_AXTCHAIN') so that they apply to
    pipeline runs only and not to the module tests, which set their own options.

    Pair meta map: [ id, preset, target_name, query_name ], plus alignment_format ('maf' or 'psl') for a
    pair with an alignment input (samplesheet column alignment), or aligner ('lastz' or 'mummer') for a
    pair aligned with LASTZ or MUMmer4 (column aligner or --aligner). Output file stems follow v1.0.0:
    <target_name>_<query_name>.{maf,psl,chain,all.chain,all.pre.chain,noClass.net,net.axt}, gzipped.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Genome preparation: one <name>.2bit and <name>.sizes per distinct FASTA
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: '.*:PREPARE_GENOMES:UCSC_FATOTWOBIT|.*:PREPARE_GENOMES:UCSC_TWOBITINFO' {
        publishDir = [
            path: { "${params.outdir}/genomes" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Alignment (CNEr presets): <outdir>/<id>/alignment/
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: '.*:PAIRWISE_ALIGN:LAST_LASTDB' {
        // Set per preset in subworkflows/local/pairwise_align (lastdbArgs): '-c' for all CNEr presets
        ext.args   = { meta.lastdb_args }
        ext.prefix = { "${meta.id}" }
        publishDir = [ enabled: false ]
    }

    withName: '.*:PAIRWISE_ALIGN:LAST_LASTAL' {
        // The scoring matrix (-p) is the preset's assets/matrices/<preset>.lastal.mat.
        // The module runs lastal -P <task.cpus>. conf/base.config sets 1 cpu; warn if a custom config raises it,
        // because lastal -P > 1 makes the MAF, and hence every chain, net and axt file, change from run to run.
        ext.args   = {
            if (task.cpus > 1) {
                // In a config file 'log' is not the Nextflow logger: use the logger of the Nextflow run directly
                org.slf4j.LoggerFactory.getLogger('nextflow').warn("Pair '${meta.id}': lastal runs with ${task.cpus} threads (-P ${task.cpus}). The alignments are the same as with 1 thread, but their order changes from run to run, and so do the chains, nets, axt files and liftOver chains. Set cpus = 1 for LAST_LASTAL for reproducible outputs (see docs/usage.md).")
            }
            [
                near   : '-a 600 -b 150 -e 3000 -s 2 -f 1',
                medium : '-a 400 -b 30 -e 4500 -s 2 -f 1',
                far    : '-a 400 -b 30 -e 6000 -s 2 -f 1',
            ][meta.preset]
        }
        ext.prefix = { "${meta.target_name}_${meta.query_name}" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.{maf.gz,tsv}'
        ]
    }

    withName: '.*:PAIRWISE_ALIGN:LASTZ' {
        // CNEr lastz() options of the preset (BLASTZ-style, from UCSC RunLastzChain_sh.txt); the scoring matrix
        // (Q=) is the preset's assets/matrices/<preset>.axtchain.mat, which is the CNEr lastz matrix.
        // The module runs one lastz per (target sequence, query sequence), up to task.cpus at a time.
        ext.args   = { [
            near   : 'C=0 E=150 H=0 K=4500 L=3000 M=254 O=600 T=2 Y=15000',
            medium : 'C=0 E=30 H=0 K=3000 L=3000 M=50 O=400 T=1 Y=9400',
            far    : 'C=0 E=30 H=2000 K=2200 L=6000 M=50 O=400 T=2 Y=3400',
        ][meta.preset] }
        ext.prefix = { "${meta.target_name}_${meta.query_name}" }
        // Intermediate: the LAV of all sequence pairs, converted to PSL by UCSC_LAVTOPSL
        publishDir = [ enabled: false ]
    }

    withName: '.*:PAIRWISE_ALIGN:UCSC_LAVTOPSL' {
        ext.prefix = { "${meta.target_name}_${meta.query_name}" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.psl.gz'
        ]
    }

    withName: '.*:PAIRWISE_ALIGN:MUMMER4_NUCMER' {
        // MUMmer4 has no CNEr preset: nucmer runs with its default options for every preset (anchors unique in the
        // target, -l 20, -c 65, -b 200, both strands). Override with ext.args in a custom config (see docs/usage.md).
        ext.args   = ''
        ext.prefix = { "${meta.target_name}_${meta.query_name}" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.delta.gz'
        ]
    }

    withName: '.*:PAIRWISE_ALIGN:CONVERT_DELTA2PSL' {
        ext.prefix = { "${meta.target_name}_${meta.query_name}" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.psl.gz'
        ]
    }

    withName: '.*:PAIRWISE_ALIGN:CHECK_ALIGNMENT' {
        // Checks an alignment input (samplesheet column alignment) and passes it on unchanged: nothing to publish
        publishDir = [ enabled: false ]
    }

    withName: '.*:PAIRWISE_ALIGN:LAST_MAFCONVERT' {
        // Converts the LAST MAF, or a MAF given in the samplesheet column alignment
        ext.prefix = { "${meta.target_name}_${meta.query_name}" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.psl.gz'
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Chains and nets: <outdir>/<id>/{chains,nets,axt}/
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: '.*:CHAIN_NET:UCSC_AXTCHAIN' {
        // The score scheme (-scoreScheme) is the preset's assets/matrices/<preset>.axtchain.mat
        ext.args   = { [
            near   : '-minScore=5000 -linearGap=medium',
            medium : '-minScore=3000 -linearGap=medium',
            far    : '-minScore=5000 -linearGap=loose',
        ][meta.preset] }
        // With --chain_chunk_size the PSL is chained in tiles (meta.chain_tile, e.g. t001_q002): the tile chains are
        // not published, all.chain (UCSC_CHAINMERGESORT) holds them all
        ext.prefix = { meta.chain_tile ? "${meta.target_name}_${meta.query_name}.${meta.chain_tile}" : "${meta.target_name}_${meta.query_name}" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/chains" },
            mode: params.publish_dir_mode,
            pattern: '*.chain.gz',
            saveAs: { filename -> meta.chain_tile ? null : filename }
        ]
    }

    withName: '.*:CHAIN_NET:CONVERT_SPLITPSL' {
        // The tiles are intermediate files of the chaining (--chain_chunk_size): nothing to publish
        publishDir = [ enabled: false ]
    }

    withName: '.*:CHAIN_NET:UCSC_CHAINMERGESORT' {
        ext.prefix = { "${meta.target_name}_${meta.query_name}.all" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/chains" },
            mode: params.publish_dir_mode,
            pattern: '*.chain.gz'
        ]
    }

    withName: '.*:CHAIN_NET:UCSC_CHAINPRENET' {
        ext.prefix = { "${meta.target_name}_${meta.query_name}.all.pre" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/chains" },
            mode: params.publish_dir_mode,
            pattern: '*.chain.gz'
        ]
    }

    withName: '.*:CHAIN_NET:UCSC_CHAINNET' {
        ext.prefix = { "${meta.target_name}_${meta.query_name}" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/nets" },
            mode: params.publish_dir_mode,
            pattern: '*.net.gz'
        ]
    }

    withName: '.*:CHAIN_NET:UCSC_NETSYNTENIC' {
        ext.prefix = { "${meta.target_name}_${meta.query_name}.noClass" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/nets" },
            mode: params.publish_dir_mode,
            pattern: '*.net.gz'
        ]
    }

    withName: '.*:CHAIN_NET:UCSC_NETTOAXT' {
        // Intermediate: unsorted net alignments, sorted by UCSC_AXTSORT
        ext.prefix = { "${meta.target_name}_${meta.query_name}.unsorted" }
        publishDir = [ enabled: false ]
    }

    withName: '.*:CHAIN_NET:UCSC_AXTSORT' {
        ext.prefix = { "${meta.target_name}_${meta.query_name}.net" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/axt" },
            mode: params.publish_dir_mode,
            pattern: '*.axt.gz'
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        liftOver chains (UCSC naming): <outdir>/<id>/liftover/<target>To<Query>.over.chain.gz
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: '.*:LIFTOVER_CHAINS:UCSC_NETCHAINSUBSET' {
        // Intermediate: chains of the syntenic net, before chainStitchId
        ext.args   = '-verbose=0'
        ext.prefix = { "${meta.target_name}_${meta.query_name}.subset" }
        publishDir = [ enabled: false ]
    }

    withName: '.*:LIFTOVER_CHAINS:UCSC_CHAINSTITCHID' {
        ext.prefix = { "${meta.target_name}To${meta.query_name.capitalize()}.over" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/liftover" },
            mode: params.publish_dir_mode,
            pattern: '*.over.chain.gz'
        ]
    }
}
